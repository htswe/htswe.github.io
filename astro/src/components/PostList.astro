---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  posts: Post[];
  showExcerpt?: boolean;
}

const { posts, showExcerpt = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <h2>
          <a href={post.url}>{post.title}</a>
        </h2>
        <p class="meta">
          {formatDate(post.date)}
          {post.categories.length > 0 && <> · {post.categories.join(', ')}</>}
        </p>
        {showExcerpt && post.excerpt && <p class="excerpt">{post.excerpt}</p>}
      </li>
    ))
  }
</ul>
