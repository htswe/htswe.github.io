---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostCard from '@/components/PostCard.astro'
import { SOCIAL_ICONS, withBase } from '@/utils'
import { config } from '@/site-config'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from '@/utils/server'

const { hero, recentPosts, education = [], skills = [], showTags, showFriends } = config.home
const introduction = (hero.summary ?? hero.about.split(/\n\s*\n/)[0] ?? '').trim()

const posts = sortMDByDate(await getBlogCollection())
const recent = recentPosts > 0 ? posts.slice(0, Math.min(recentPosts, 5)) : []
const tags = getUniqueTagsWithCount(posts).slice(0, 12)

const socialItems = Object.entries(config.footer.social ?? {}).map(([key, item]) => ({
  ...item,
  icon: SOCIAL_ICONS[key] ?? 'i-lucide-link'
}))
---

<BaseLayout>
  <div class="mx-auto max-w-[47.5rem]">
    <!-- Hero -->
    <div id="content-header" class="animate not-prose mb-12 border-b border-line pb-10">
      <div class="flex items-center gap-4 sm:gap-5">
        <img
          src={withBase(config.site.avatar)}
          alt={config.site.author}
          width="72"
          height="72"
          loading="eager"
          decoding="async"
          class="size-16 shrink-0 rounded-full border border-line object-cover sm:size-18"
        />
        <div class="min-w-0">
          <h1 class="font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
            {config.site.author}
          </h1>
          {
            hero.tagline && (
              <p class="mt-2 text-xs leading-relaxed tracking-wide text-ink-soft sm:text-sm">
                {hero.tagline}
              </p>
            )
          }
        </div>
      </div>

      {
        introduction && (
          <div class="mt-5 max-w-2xl space-y-3 text-base leading-relaxed text-ink-soft">
            {introduction
              .split(/\n\s*\n/)
              .filter(Boolean)
              .map((paragraph) => (
                <p>{paragraph}</p>
              ))}
          </div>
        )
      }

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          hero.location && (
            <span class="inline-flex items-center gap-1 text-sm text-ink-soft">
              <span class="i-lucide-map-pin size-3.5" aria-hidden="true" />
              {hero.location}
            </span>
          )
        }
        {
          socialItems.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer"
              aria-label={item.label}
              title={item.label}
              class="icon-link size-9"
            >
              <span class={`${item.icon} size-4`} aria-hidden="true" />
            </a>
          ))
        }
        {
          hero.buttons && hero.buttons.length > 0 && (
            <div class="flex flex-wrap items-center justify-center gap-3">
              {hero.buttons.map((btn) => (
                <a
                  href={withBase(btn.link)}
                  class="link-ink inline-flex min-h-9 items-center text-sm"
                  data-astro-prefetch
                >
                  {btn.title}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <!-- Recent posts -->
    {
      recent.length > 0 && (
        <section aria-label="Posts" class="animate not-prose mb-16" style="animation-delay: 60ms">
          <div class="mb-5 flex items-end justify-between">
            <h2 class="font-serif text-xl font-normal">Posts</h2>
            <a href={withBase('/blog')} class="link-ink text-sm" data-astro-prefetch>
              More posts →
            </a>
          </div>
          <div class="flex flex-col">
            {recent.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Education -->
    {
      education.length > 0 && (
        <section
          aria-label="Education"
          class="animate not-prose mb-16"
          style="animation-delay: 120ms"
        >
          <div class="mb-5 flex items-end justify-between">
            <h2 class="font-serif text-xl font-normal">Education</h2>
          </div>
          <div class="paper-card divide-y divide-line overflow-hidden">
            {education.map((item) => (
              <div class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-baseline sm:justify-between">
                <div>
                  <p class="font-serif font-semibold leading-snug">{item.school}</p>
                  {(item.major || item.degree) && (
                    <p class="mt-0.5 text-sm text-ink-soft">
                      {[item.major, item.degree].filter(Boolean).join(' · ')}
                    </p>
                  )}
                </div>
                <p class="shrink-0 font-mono text-xs text-ink-soft sm:ms-6">{item.date}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Skills -->
    {
      skills.length > 0 && (
        <section aria-label="Skills" class="animate not-prose mb-16" style="animation-delay: 180ms">
          <div class="mb-5 flex items-end justify-between">
            <h2 class="font-serif text-xl font-normal">Skills</h2>
          </div>
          <div class="flex flex-col gap-5">
            {skills.map((group) => (
              <div>
                <h3 class="mb-2 text-sm font-semibold uppercase tracking-widest text-ink-soft">
                  {group.title}
                </h3>
                <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-soft">
                  {group.items.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Tags (optional) -->
    {
      showTags && tags.length > 0 && (
        <section aria-label="Tags" class="animate not-prose mb-16" style="animation-delay: 240ms">
          <div class="mb-5 flex items-end justify-between">
            <h2 class="font-serif text-xl font-normal">Tags</h2>
            <a href={withBase('/tags')} class="link-ink text-sm" data-astro-prefetch>
              All tags →
            </a>
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-2">
            {tags.map(([tag, count]) => (
              <a href={withBase(`/tags/${tag}`)} class="tag-link" data-astro-prefetch>
                #{tag}
                <span class="font-mono text-[10px] opacity-70">{count}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Friends (optional) -->
    {
      showFriends && config.friends.length > 0 && (
        <section aria-label="Friends" class="animate not-prose" style="animation-delay: 300ms">
          <div class="mb-5 flex items-end justify-between">
            <h2 class="font-serif text-xl font-normal">Friends</h2>
            <a href={withBase('/links')} class="link-ink text-sm" data-astro-prefetch>
              All friends →
            </a>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            {config.friends.slice(0, 3).map((friend) => (
              <a
                href={friend.url}
                target="_blank"
                rel="noreferrer"
                class="paper-card group flex items-center gap-3 px-4 py-3"
              >
                {friend.avatar && (
                  <img
                    src={withBase(friend.avatar)}
                    alt=""
                    loading="lazy"
                    class="size-9 shrink-0 rounded-full border border-line bg-wash object-cover"
                  />
                )}
                <span class="min-w-0">
                  <span class="block truncate font-serif font-semibold group-hover:text-accent">
                    {friend.name}
                  </span>
                  <span class="block truncate text-xs text-ink-soft">{friend.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
