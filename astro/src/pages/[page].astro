---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, paginate, pageUrl, type Page } from '../lib/posts';
import { SITE } from '../consts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / SITE.paginate));
  const paths = [];
  // page 1 is served by index.astro; emit /page2/ .. /pageN/
  for (let n = 2; n <= totalPages; n++) {
    paths.push({ params: { page: `page${n}` }, props: { currentPage: n } });
  }
  return paths;
};

interface Props {
  currentPage: number;
}

const { currentPage } = Astro.props;
const posts = await getPosts();
const page: Page = paginate(posts, currentPage);
---

<BaseLayout title={`Page ${currentPage}`}>
  <h1>Latest posts</h1>
  <PostList posts={page.posts} />

  <nav class="pagination">
    {page.prevUrl ? <a href={page.prevUrl}>‹ Previous</a> : <span class="spacer"></span>}
    <span>Page {page.currentPage} of {page.totalPages}</span>
    {page.nextUrl ? <a href={page.nextUrl}>Next ›</a> : <span class="spacer"></span>}
  </nav>
  <p class="meta">
    <a href="/">← Back to start</a> · <a href={pageUrl(1)}>{pageUrl(1)}</a>
  </p>
</BaseLayout>
