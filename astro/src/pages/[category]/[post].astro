---
// Legacy Jekyll permalinks: /:category/:slug/ (e.g. /tech/why-kotlin/).
// These render the same article as the theme's /blog/<id>/ route so inbound
// links from the old site keep working; the canonical URL points at /blog/.
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import PostLayout from '@/layouts/PostLayout.astro'
import { getPostReadingTime, postUrl } from '@/utils/server'

export const prerender = true

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: {
      category: (post.data.category ?? 'uncategorised').toLowerCase(),
      post: post.data.slug ?? post.id
    },
    props: { post, canonical: postUrl(post.id) }
  }))
}) satisfies GetStaticPaths

interface Props {
  post: CollectionEntry<'blog'>
  canonical: string
}

const { post, canonical } = Astro.props as Props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const minutesRead = getPostReadingTime(post)
---

<PostLayout
  post={post}
  {headings}
  {minutesRead}
  hasMath={remarkPluginFrontmatter.hasMath === true}
  canonicalPath={canonical}
>
  <Content />
</PostLayout>
